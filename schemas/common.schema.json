{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.ai-infrastructure-digital-twin.local/common.schema.json","title":"Common Definitions","$defs":{"timestamp":{"type":"string","format":"date-time","description":"ISO 8601 timestamp with timezone."},"date":{"type":"string","format":"date","description":"ISO 8601 calendar date."},"source_id":{"type":"string","pattern":"^SOURCE-[A-Z0-9]+-[0-9]{4}(?:-Q[1-4])?(?:-[0-9]{3})?$","description":"Registered source-document identifier."},"source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/source_id"},"description":"Source Document IDs supporting this record."},"confidence_score":{"type":"integer","minimum":1,"maximum":5,"description":"Evidence confidence: 5 SEC verified; 4 company confirmed; 3 multiple independent sources; 2 credible reporting; 1 unverified/speculative."},"status":{"type":"string","enum":["planned","active","inactive","completed","cancelled","superseded","unknown"],"description":"Current record or entity lifecycle state."},"notes":{"type":["string","null"],"maxLength":10000,"description":"Optional factual clarification; do not store undocumented facts here."},"currency":{"type":"string","pattern":"^[A-Z]{3}$","description":"ISO 4217 currency code."},"percentage":{"type":"number","minimum":0,"maximum":1,"description":"Decimal fraction where 1 equals 100 percent."}}}
