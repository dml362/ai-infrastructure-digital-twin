{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.ai-infrastructure-digital-twin.local/financing.schema.json","title":"Financing","type":"object","additionalProperties":false,"required":["id","schema_version","created_at","modified_at","source_ids","confidence_score","status","notes","company_id","financing_type","currency","principal_amount"],"properties":{"id":{"type":"string","pattern":"^FINANCING-[0-9a-fA-F-]{36}$"},"schema_version":{"const":"0.1.0"},"created_at":{"$ref":"common.schema.json#/$defs/timestamp"},"modified_at":{"$ref":"common.schema.json#/$defs/timestamp"},"source_ids":{"$ref":"common.schema.json#/$defs/source_ids"},"confidence_score":{"$ref":"common.schema.json#/$defs/confidence_score"},"status":{"$ref":"common.schema.json#/$defs/status"},"notes":{"$ref":"common.schema.json#/$defs/notes"},"company_id":{"type":"string","pattern":"^COMPANY-"},"campus_id":{"type":["string","null"],"pattern":"^CAMPUS-"},"project_id":{"type":["string","null"],"pattern":"^PROJECT-"},"financing_type":{"type":"string","enum":["term_loan","revolver","bond","convertible","project_finance","equity","tax_credit","other"]},"currency":{"$ref":"common.schema.json#/$defs/currency"},"principal_amount":{"type":"number","minimum":0},"interest_rate":{"anyOf":[{"$ref":"common.schema.json#/$defs/percentage"},{"type":"null"}]},"issue_date":{"anyOf":[{"$ref":"common.schema.json#/$defs/date"},{"type":"null"}]},"maturity_date":{"anyOf":[{"$ref":"common.schema.json#/$defs/date"},{"type":"null"}]},"lender_or_investor":{"type":["string","null"]}}}
