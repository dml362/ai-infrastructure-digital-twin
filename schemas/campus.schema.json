{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://schemas.ai-infrastructure-digital-twin.local/campus.schema.json","title":"Campus","type":"object","additionalProperties":false,"required":["id","schema_version","created_at","modified_at","source_ids","confidence_score","status","notes","company_id","name","country_code"],"properties":{"id":{"type":"string","pattern":"^CAMPUS-[0-9a-fA-F-]{36}$"},"schema_version":{"const":"0.1.0"},"created_at":{"$ref":"common.schema.json#/$defs/timestamp"},"modified_at":{"$ref":"common.schema.json#/$defs/timestamp"},"source_ids":{"$ref":"common.schema.json#/$defs/source_ids"},"confidence_score":{"$ref":"common.schema.json#/$defs/confidence_score"},"status":{"$ref":"common.schema.json#/$defs/status"},"notes":{"$ref":"common.schema.json#/$defs/notes"},"company_id":{"type":"string","pattern":"^COMPANY-"},"name":{"type":"string","minLength":1},"country_code":{"type":"string","pattern":"^[A-Z]{2}$"},"region":{"type":["string","null"]},"city":{"type":["string","null"]},"latitude":{"type":["number","null"],"minimum":-90,"maximum":90},"longitude":{"type":["number","null"],"minimum":-180,"maximum":180},"site_area_acres":{"type":["number","null"],"minimum":0}}}
